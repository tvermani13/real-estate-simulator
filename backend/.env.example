APP_VERSION=0.2.0
ENVIRONMENT=development
FRED_API_KEY=
SOFR_SERIES_ID=SOFR
EFFR_SERIES_ID=EFFR
CORS_ALLOW_ORIGINS=http://localhost:3000

DATABASE_PATH=data/real_estate_simulator.db
SESSION_COOKIE_NAME=res_session
SESSION_DAYS=30
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
REGISTRATION_ENABLED=true

RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRUST_PROXY_HEADERS=false
SCAN_LEASE_MINUTES=15

PROPERTY_PROVIDER=rentcast
RENTCAST_API_KEY=
SCANNER_RESULT_LIMIT=24

# Optional email delivery for new property matches.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Platform sign-in (platform ADR 0007 and 0012). Keep off until staging acceptance has passed.
# The key set must be served on loopback by the session edge; any other host is refused (503).
PLATFORM_CONTEXT=off
PLATFORM_JWKS_URL=http://127.0.0.1:9190/.well-known/platform-jwks.json
